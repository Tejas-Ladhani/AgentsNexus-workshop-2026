{
  "tools": [
    {
      "name": "lookup_order_hardened",
      "description": "Returns a redacted order status for a validated identifier. Connections are automatically closed. This read-only operation is idempotent.",
      "timeoutMs": 30000,
      "maxRetries": 3,
      "exponentialBackoff": true,
      "rateLimit": "100/minute",
      "version": "1.0.0",
      "observability": {"logging": true, "metrics": true},
      "errorSchema": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
      "outputSchema": {"type": "object", "properties": {"order_id": {"type": "string"}, "status": {"type": "string"}}},
      "inputSchema": {"type": "object", "properties": {"order_id": {"type": "string", "pattern": "^ORD-[0-9]{4}$"}}, "required": ["order_id"], "additionalProperties": false}
    },
    {
      "name": "generate_monthly_report",
      "description": "Generates a bounded monthly report for an approved reporting period. The operation is idempotent.",
      "timeoutMs": 600000,
      "maxRetries": 3,
      "exponentialBackoff": true,
      "rateLimit": "10/hour",
      "version": "1.0.0",
      "observability": {"logging": true},
      "errorSchema": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
      "outputSchema": {"type": "object", "properties": {"report_id": {"type": "string"}}},
      "inputSchema": {"type": "object", "properties": {"month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}}, "required": ["month"], "additionalProperties": false}
    },
    {
