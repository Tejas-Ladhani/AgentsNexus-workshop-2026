      "timeoutMs": 30000,
      "maxRetries": -1,
      "exponentialBackoff": true,
      "rateLimit": "20/minute",
      "version": "1.0.0",
      "observability": {"metrics": true},
      "errorSchema": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
      "outputSchema": {"type": "object", "properties": {"synced": {"type": "integer"}}},
      "inputSchema": {"type": "object", "properties": {"batch_id": {"type": "string", "maxLength": 32}}, "required": ["batch_id"], "additionalProperties": false}
    },
    {
      "name": "create_support_case",
