      "timeoutMs": 30000,
      "maxRetries": 3,
      "exponentialBackoff": true,
      "rateLimit": "30/minute",
      "version": "1.0.0",
      "observability": {"tracing": true},
      "errorSchema": {"type": "object", "properties": {"message": {"type": "string"}}},
      "outputSchema": {"type": "object", "properties": {"case_id": {"type": "string"}}},
      "inputSchema": {"type": "object", "properties": {"customer_id": {"type": "string", "maxLength": 32}}, "required": ["customer_id"], "additionalProperties": false}
    },
    {
